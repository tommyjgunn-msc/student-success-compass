# Student Success Compass: environment variables
# Copy to .env.local for local development. Never commit .env.local.
#
# With the Google variables left blank, `npm run dev` stores responses in
# .data/ on your machine instead of Google Sheets. Production refuses to run
# without them and keeps the Compass closed.

# Google Sheet that receives responses (the ID is the long string in its URL)
GOOGLE_SHEET_ID=

# Service account that has Editor access to the sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account's private key, with newlines written as \n, in quotes
GOOGLE_PRIVATE_KEY=

# Tab holding the open/closed switch in cell A2 (unchanged from version 1)
GOOGLE_CONFIG_SHEET_NAME=Config

# Optional. Tab that receives version 2 responses. Created automatically,
# together with a codebook tab, on the first submission.
COMPASS_RESPONSES_SHEET=Compass v2.0

# Password for /admin. Use at least 32 random characters:
#   openssl rand -base64 32
# Changing it signs every admin out.
ADMIN_SECRET_KEY=
